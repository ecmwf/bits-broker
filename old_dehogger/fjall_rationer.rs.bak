use std::{collections::HashMap, path::{Path, PathBuf}, time::{SystemTime, UNIX_EPOCH}};
use fjall::{Config, PersistMode, Keyspace, PartitionCreateOptions};
use rand::{random, rngs::StdRng, Rng, SeedableRng};
use serde::{Serialize, Deserialize};
use crate::rationer::{Rationer, Pressure, Resources};
use uuid::Uuid;
use sha2::{Sha256, Digest};

// An implementation of the rationer based on a local fjall storage. Suitable for consumers with a shared filesystem.


// ==============================
// ===      fjall rationer     ===
// ==============================

pub struct FjallRationer {
    path: PathBuf,
    keyspace: Keyspace,
    peers_partition: fjall::Partition,
    total_state_partition: fjall::Partition,
    peer_ttl: u64,
    state: Peer,
    local_peer: Peer,
    total_state: TotalState,
}

// Peer should not be visible to the user
#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
struct Peer {
    pub id: String,
    pub pressure: Pressure,
    pub target_allocation: Resources,
    pub actual_allocation: Resources,
    pub usage: Resources,
    pub last_heartbeat: u128,
}

impl Peer {
    pub fn new(id: String) -> Self {
        Peer {
            id,
            pressure: HashMap::new(),
            target_allocation: HashMap::new(),
            actual_allocation: HashMap::new(),
            usage: HashMap::new(),
            last_heartbeat: 0,
        }
    }
    
    fn is_expired(&self, peer_ttl: u64) -> bool {
        let now = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis();
        now > self.last_heartbeat + peer_ttl as u128*1000
    }
}

#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
struct TotalState {
    total_resources: Resources,
}

impl TotalState {
    pub fn new(total_resources: Resources) -> Self {
        TotalState { total_resources }
    }
}

impl FjallRationer {

    pub fn new(path: PathBuf, peer_ttl: u64, total_resources: Resources) -> Result<Self, fjall::Error> {
        let keyspace = Config::new(&path).open()?;
        let peers_partition = keyspace.open_partition("peers", PartitionCreateOptions::default())?;
        let total_state_partition = keyspace.open_partition("total_state", PartitionCreateOptions::default())?;
        let total_state = TotalState::new(total_resources);
        total_state_partition.insert(b"total", serde_json::to_string(&total_state).unwrap().as_bytes())?;

        let peer_id = format!("peer-{}", Uuid::new_v4());
        let peer = Peer::new(peer_id.clone());
        Ok(FjallRationer { 
            path,
            keyspace,
            peers_partition, 
            total_state_partition,
            peer_ttl, 
            state: peer.clone(),
            local_peer: peer,
            total_state,
        })
    }

    fn get_all_peers(&self, remove_expired: bool) -> Result<Vec<Peer>, ()> {
        let mut all_peers = self.peers_partition
            .prefix(b"peer-")
            .collect::<Result<Vec<_>, _>>()
            .map_err(|_| ())?
            .into_iter()
            .map(|(_, v)| serde_json::from_slice::<Peer>(&v).map_err(|_| ()))
            .collect::<Result<Vec<Peer>, _>>()?;

        if remove_expired {
            all_peers.retain(|peer| {
                if peer.is_expired(self.peer_ttl) {
                    let _ = self.peers_partition.remove(peer.id.as_bytes()).map_err(|_| ());
                    false
                } else {
                    true
                }
            });
        }

        // Sort peers by ID
        all_peers.sort_by(|a, b| a.id.cmp(&b.id));

        Ok(all_peers)
    }
}

impl Rationer for FjallRationer {

    // Heartbeat should set TTL, clean up expired peers, and sync the server state to the local state
    

    // Set pressure should check if the pressure is actually changing

    // Need to think about the locking/atomicity of the operations
    // How to handle multiple recomputations of the target allocation
    // If we lock, pressure changes will be blocked
    // Really the two things should be desynchronised
    // Do reallocation from a snapshot of the pressure state
    // and then the only issue is if multiple peers do reallocation, how to choose the winner
    // maybe revision number the pressure changes, then realloaction is only tx'ed if the revision number is higher
    // realloaction should be in another thread so that the pressure changes can be done in parallel

    // reallocation thread pulls pressures, see if they need an update, if so, does the realloaction.


    // In the future, reallocation could be done by a standalone service

    // NOTE FJALL IS NOT PROCESS SAFE


    fn heartbeat(&mut self) -> Result<(),()> {
        
        let all_peers = self.get_all_peers(true)?;

        let total_resources = self.total_state_partition.get(b"total").map_err(|_| ())?.expect("No total state found");
        let total_resources: TotalState = serde_json::from_slice(&total_resources).map_err(|_| ())?;

        // Delete any old peers
        for resource in total_resources.total_resources.keys() {

            let total_pressure: f64 = all_peers.iter().map(|peer| peer.pressure.get(resource).unwrap_or(&0.0)).sum();
            let total_resource = total_resources.total_resources.get(resource).unwrap_or(&0);

            // if the resource is not requested by any peer, set the target allocation to 0
            if total_pressure == 0.0 {
                self.state.target_allocation.insert(resource.clone(), 0);
                continue;
            }

            let mut total_allocated = 0;

            let target_allocations = all_peers.iter().map(|peer| {
                let peer_pressure = *peer.pressure.get(resource).unwrap_or(&0.0);
                let proportion = peer_pressure / total_pressure;
                let allocation = (*total_resource as f64 * proportion).floor() as i64;
                total_allocated += allocation;
                (peer.id.clone(), allocation)
            }).collect::<Vec<(String, i64)>>();

            let leftover = total_resource - total_allocated;

            // create a seed from all peer ids hashed together
            // note peers are sorted by id, so the order is deterministic and the seed is deterministic
            
            let mut hasher = Sha256::new();
            for (i, peer) in all_peers.iter().enumerate() {
                if i > 0 { hasher.update(b"|"); } // separator
                hasher.update(peer.id.as_bytes());
            }
            let seed = hasher.finalize();
            let rng = StdRng::from_seed(seed);
            
            // distribute the leftover resources to the peers randomly, but deterministically
            for i in 0..leftover {
                let index = rng.random_range(0..=all_peers.len()-1);
                target_allocations[index].1 += 1;
            }

            // Update target allocation for this peer
            self.state.target_allocation.insert(resource.clone(), total_allocated);
        }
        
        self.keyspace.persist(PersistMode::SyncAll).map_err(|_| ())?;
        
        Ok(())
    }

    fn set_pressure(&mut self, pressure: &Pressure) -> Result<(),()> {
        self.state.pressure = pressure.clone();
        self.peers_partition.insert(self.state.id.as_bytes(), serde_json::to_string(&self.state).unwrap().as_bytes()).map_err(|_| ())?;
        self.keyspace.persist(PersistMode::SyncAll).map_err(|_| ())?;
        Ok(())
    }

    fn allocate(&mut self, resources: &Resources) -> Result<(),()> {
        todo!()
    }

    fn free(&mut self, resources: &Resources) {
        todo!()
    }
}

